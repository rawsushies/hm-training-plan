# Firebase WEB client configuration (Project settings → General → Your apps → Web app).
# These values are PUBLIC identifiers, not secrets: access is controlled by firestore.rules and
# the authorised domains list in Firebase Authentication. Copy them into public/firebase-config.js.
# NEVER put service-account keys, Admin SDK credentials or OAuth client secrets in this repo.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
