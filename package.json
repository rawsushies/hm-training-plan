{
  "name": "hm-training-plan",
  "private": true,
  "version": "3.1.0",
  "description": "Half Marathon Training Plan: single-file mobile web app with Firebase (Google sign-in + Firestore) sync",
  "type": "module",
  "scripts": {
    "serve": "http-server public -p 5173 -c-1",
    "test": "node --test test/unit/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-hmtp \"node --test test/rules/*.test.js\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-hmtp \"node --test --test-concurrency=1 test/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:rules && npm run test:e2e",
    "emulators": "firebase emulators:start --project demo-hmtp",
    "release": "node scripts/release.mjs",
    "check:release": "node scripts/release.mjs --verify",
    "deploy": "npm run check:release && firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "android:sync": "npx cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.35.0",
    "http-server": "^14.1.1",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5"
  }
}
